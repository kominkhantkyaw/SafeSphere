# ── Dependencies ──────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────
dist/
dist-ssr/
build/
coverage/
stats.html

# ── Environment / Secrets (never commit API keys or secrets) ─
.env
.env.*
!.env.example
.env.local
.env.production.local
*.pem
secrets/
**/api-key*
**/apiKey*
**/apikey*

# ── Documentation & reports (local only — not pushed) ───────────
# Whole docs tree (notes, diagrams, rubrics, scripts, etc.)
docs/

# Office / academic file types
*.pdf
*.PDF
*.docx
*.DOCX
*.doc
*.DOC
*.xlsx
*.xls
*.pptx
*.ppt
*.odt
*.rtf

# Markdown: ignore all; track ONLY README.md at repository root (not subfolders)
*.md
!/README.md

# ── Images & design sources ─────────────────────
# Raster/SVG used by the app (e.g. public/, src/) stay tracked — do not add *.png globally.
# Anything under docs/ is already ignored (report figures, diagrams, etc.).
# Design tool originals (local only):
*.psd
*.PSD
*.ai
*.sketch
*.fig
# Loose screenshots / exports you drop in the repo root or ad-hoc folders:
screenshots/
captures/

# ── Archive files ─────────────────────────────────
*.zip
*.tar.gz
*.rar
*.7z

# ── Text and data exports (optional local exports) ─
*.txt
!public/robots.txt
*.csv

# ── Database dumps / local DB files ─────────────────
backend/supabase/safesphere_postgres.sql
*.db
*.sqlite
*.sqlite3

# ── Utility scripts (optional — remove this line if you want scripts pushed)
scripts/

# ── Logs ──────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editor / IDE (do not commit Cursor agent or config) ─
.cursor/
cursor-agent/
*.cursoragent
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


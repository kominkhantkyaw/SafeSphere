# SafeSphere Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local – it contains your real API keys.

# Supabase (required for online mode - dual offline/online storage)
# Get these from your Supabase project: Project Settings → API
# URL must be your project URL, e.g. https://YOUR_PROJECT_REF.supabase.co
# Do NOT use https://www.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Gemini API (for AI Safety Assistant in Chat)
# VITE_GEMINI_API_KEY is required - Vite only exposes VITE_ prefixed vars to the browser
# Get your key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase Edge Function Secrets (set via `supabase secrets set`) ──
# These are NOT VITE_ vars — they live on the Supabase server, not in the browser.
#
# Email confirmation (Resend) — used by send-confirmation-email Edge Function
# RESEND_API_KEY=re_xxxxxxxxx
#
# SMS confirmation (Twilio) — used by send-confirmation-sms Edge Function
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
